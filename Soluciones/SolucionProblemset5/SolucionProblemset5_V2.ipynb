    "(* Magnitud del campo en el plano ecuatorial z=0 *)\n",
    "(* Usamos la funcion general con z -> 0.0001 para evitar singularidad en r=0 *)\n",
    "BmagEqSafe[x_, y_] := Bmag[x, y, 0.0001];\n",
    "\n",
    "dplot1 = DensityPlot[\n",
    "  Log10[BmagEqSafe[x, y]],\n",
    "  {x, -8, 8}, {y, -8, 8},\n",
    "  PlotPoints -> 80,\n",
    "  ColorFunction -> \"SunsetColors\",\n",
    "  ColorFunctionScaling -> True,\n",
    "  RegionFunction -> Function[{x, y, z}, x^2 + y^2 > 1.01],\n",
    "  Frame -> True,\n",
    "  FrameLabel -> {\n",
    "    Style[\"x (unidades de R\\[CirclePlus])\", 13],\n",
    "    Style[\"y (unidades de R\\[CirclePlus])\", 13]\n",
    "  },\n",
    "  PlotLegends -> BarLegend[Automatic, LegendLabel -> Style[\"log\\[Subscript]10 |B| (nT)\", 11]],\n",
    "  Epilog -> {\n",
    "    (* Circulo terrestre *)\n",
    "    Thick, Gray, Circle[{0, 0}, 1],\n",
    "    (* Puntos de los incisos *)\n",
    "    PointSize[0.02], Red, Point[{xa, ya}],\n",
    "    PointSize[0.015], Blue, Point[{xb, yb}],\n",
    "    PointSize[0.012], Green, Point[{xc, yc}],\n",
    "    (* Etiquetas *)\n",
    "    Style[Text[\"(a)\", {xa+0.4, ya+0.4}], Red, 11],\n",
    "    Style[Text[\"(b)\", {xb+0.4, yb+0.4}], Blue, 11],\n",
    "    Style[Text[\"(c)\", {xc+2, yc}], Darker[Green], 11]\n",
    "  },\n",
    "  PlotLabel -> Style[\"Campo Magnético Terrestre — Plano Ecuatorial (z \\[TildeEqual] 0)\", 14, Bold],\n",
    "  ImageSize -> 500\n",
    "]"
   ]
