    "(* Valores en cada posicion *)\n",
    "posLabels = {\"(a) Satelite\\nr=7\", \"(b) Van Allen\\nr=3\", \"(c) Luna\\nr=60\"};\n",
    "magValues = {N[Bmaga], N[Bmagb], N[Bmagc]};\n",
    "\n",
    "colors = {RGBColor[0.85, 0.2, 0.2], RGBColor[0.2, 0.45, 0.85], RGBColor[0.2, 0.75, 0.3]};\n",
    "\n",
    "BarChart[\n",
    "  magValues,\n",
    "  ChartLabels -> Placed[posLabels, Below],\n",
