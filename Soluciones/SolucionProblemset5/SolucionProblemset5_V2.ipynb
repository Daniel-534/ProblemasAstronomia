   "source": [
    "Clear[\"Global`*\"];\n",
    "\n",
    "(* ── Restricciones sobre la masa del boson de Higgs ── *)\n",
    "\n",
    "(* Tevatron: m > 170 GeV  ó  m < 160 GeV *)\n",
    "r1 = m > 170 || m < 160;\n",
    "\n",
    "(* LEP: m > 115 GeV *)\n",
    "r2 = m > 115;\n",
    "\n",
    "(* Modelo Estandar: 80 < m < 200 GeV (con limite adicional m < 190 GeV) *)\n",
    "r3 = 80 < m < 200;\n",
    "\n",
    "(* Interseccion de todas las restricciones *)\n",
    "Sol = Reduce[r1 && r2 && r3, m, Reals]\n"
   ]
